# Server-only values. Keep all real values in Vercel secret settings.
# Use separate Square configurations for FRX and WorkForge.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# Existing Supabase project URL and publishable key remain unchanged.
# WorkForge also needs this server-only key; never use NEXT_PUBLIC_ for it.
SUPABASE_SECRET_KEY=
